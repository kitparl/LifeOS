# ENV=dev → development mode (production=false, insecure cookies OK for localhost)
# ENV=production (default) → production mode (secure cookies, no /docs)
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./lifeos_dev.db
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:4200
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides (unset = derived from ENV)
# COOKIE_SECURE=false

# Fernet key for encrypting integration secrets (bot tokens) at rest.
# If unset, a stable key is derived from SECRET_KEY. Prefer setting explicitly in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_ENC_KEY=tvZo5gTTkJqcRM7uVHvsSVbBbGll1X2wtZSPpNWCfw0=
#
# Production: serve the API only over HTTPS (TLS at reverse proxy / VPS).
