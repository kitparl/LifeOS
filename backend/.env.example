# ENV=dev → development mode (production=false, insecure cookies OK for localhost)
# ENV=production (default) → production mode (secure cookies, no /docs)
# In production, SECRET_KEY must NOT be the default below, and INTEGRATION_ENC_KEY is required.
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./lifeos_dev.db
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:4200
# Fallback only: users' own keys in Integrations → AI Integration (BYOK) take precedence.
# OPENAI_API_KEY is used for users with no enabled OpenAI key; AI_CHAT_MODEL is the OpenAI chat
# model used when no model is chosen. Embeddings (RAG search) always use OpenAI + AI_EMBEDDING_MODEL.
# See setup/AI_INTEGRATION_SETUP.md.
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides (unset = derived from ENV)
# COOKIE_SECURE=false

# Fernet key for encrypting integration secrets (bot tokens) at rest.
# REQUIRED when ENV=production. In development, if unset, a stable key is derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_ENC_KEY=tvZo5gTTkJqcRM7uVHvsSVbBbGll1X2wtZSPpNWCfw0=
#
# Public HTTPS base URL of this API (no trailing slash) — required for Telegram setWebhook.
# Example: https://lifeos.example.com
# PUBLIC_BASE_URL=
#
# Dev fallback: long-poll getUpdates when you have no public HTTPS URL (do not combine with webhook).
# TELEGRAM_POLLING_ENABLED=true
#
# Production: serve the API only over HTTPS (TLS at reverse proxy / VPS).
# Set PUBLIC_BASE_URL=https://your-domain and Register webhook in the Integrations UI.
# Keep TELEGRAM_POLLING_ENABLED=false when using webhooks.

# --- Registration gate (admin-only unlock for /register) ---
# Only this email may unlock registration for the current browser session.
# ADMIN_GATE_PASSWORD_HASH must be a bcrypt hash — never store plaintext.
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# ADMIN_GATE_EMAIL=you@example.com
# ADMIN_GATE_PASSWORD_HASH=

# --- Google login (Sign in with Google) ---
# OAuth Web Client ID from Google Cloud Console (see GOOGLE_LOGIN_SETUP.md). No client secret needed.
# Unset = the Google button is hidden. Only existing users (matched by email) can sign in.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- Google Calendar sync (Integrations; separate from login) ---
# Reuses GOOGLE_CLIENT_ID. See GOOGLE_CALENDAR_SETUP.md. Unset = Connect is disabled.
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4200/integrations

# --- File storage ---
# Prefer an absolute path on the VPS (see docs/FILE_STORAGE.md).
# UPLOAD_DIR=/var/lib/lifeos/uploads
STORAGE_BACKEND=local
# MAX_UPLOAD_BYTES=10485760
# USER_STORAGE_QUOTA_BYTES=1073741824
# UPLOADS_PER_HOUR=100
# DOWNLOAD_TOKEN_TTL_SECONDS=300
# FILE_PURGE_AFTER_DAYS=30
# ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/markdown,text/csv,audio/mpeg,audio/ogg,audio/webm,audio/mp4

# --- Document preview (Office -> PDF via headless LibreOffice; requires `soffice` on PATH) ---
# Prefer an absolute path outside the repo on the VPS, same reasoning as UPLOAD_DIR.
# PREVIEW_CACHE_DIR=/var/lib/lifeos/preview-cache
# PREVIEW_MAX_FILE_BYTES=26214400
# CONVERSION_TIMEOUT_SECONDS=60
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=   # required for Cloudflare R2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
